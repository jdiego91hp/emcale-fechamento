# ================================================================
# .env.example — Sistema de Fechamento Técnico Emcale
# Copie para .env.local e preencha antes de rodar o projeto
# ================================================================

# ── SUPABASE PÚBLICO (ok expor no frontend) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── SUPABASE PRIVADO (NUNCA expor — apenas server/API routes) ────
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── GOOGLE SHEETS (NUNCA expor — apenas server/API routes) ───────
# ID da planilha (retirado da URL do Google Sheets)
GOOGLE_SHEETS_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# E-mail da Service Account criada no Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=emcale@seu-projeto.iam.gserviceaccount.com

# Chave privada da Service Account (cole com \n para quebras de linha)
# Na Vercel, cole o conteúdo entre aspas duplas
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0B...\n-----END PRIVATE KEY-----\n"

# ── APP (público) ────────────────────────────────────────────────
# URL base do sistema (sem barra final)
# Local:  http://localhost:3000
# Vercel: https://emcale-fechamento.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
